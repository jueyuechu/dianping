# ================= 只跟踪后端 dianping-platform =================
# 忽略根目录下所有内容，再白名单放行后端目录
/*
!/.gitignore
!/dianping-platform/

# ================= 后端：构建产物 =================
dianping-platform/**/target/
dianping-platform/**/build/
dianping-platform/**/out/
*.class
*.jar
*.war

# ================= 后端：IDE / 编辑器 =================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
*.swp

# ================= 后端：日志 / 临时文件 =================
*.log
logs/
*.tmp
*.bak

# ================= 后端：本地敏感配置（按需放开） =================
# application-local.yml
# application-prod.yml

# ================= 操作系统 =================
.DS_Store
Thumbs.db
desktop.ini
