# =====================================================================
# 环境变量模板：复制为 .env 后按需修改
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# .env 已被 .gitignore 忽略，模板文件可提交
# =====================================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dianping
DB_USERNAME=root
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

# ---------- JWT（HS256 要求至少 32 字节，生产环境务必更换） ----------
JWT_USER_SECRET=change-me-user-jwt-secret-at-least-32-bytes
JWT_USER_TTL=604800000
JWT_ADMIN_SECRET=change-me-admin-jwt-secret-at-least-32-bytes
JWT_ADMIN_TTL=7200000
JWT_MERCHANT_SECRET=change-me-merchant-jwt-secret-at-least-32-bytes
JWT_MERCHANT_TTL=7200000

# ---------- 微信小程序 ----------
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
WECHAT_MOCK=true

# ---------- Spring AI（OpenAI 兼容协议） ----------
# AI_MOCK=true 使用内置规则，无需真实 Key；接入真实模型时改为 false 并填写 AI_API_KEY
AI_MOCK=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-not-configured
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0
AI_MAX_ROWS=50

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dianping
MINIO_URL_PREFIX=/minio

# ---------- 高德地图 Web 服务 ----------
AMAP_KEY=your-amap-key

# ---------- 文件上传 ----------
UPLOAD_MODE=local
UPLOAD_LOCAL_PATH=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
